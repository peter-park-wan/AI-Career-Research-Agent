OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
GITHUB_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=AI_Career_Research_Agent
LANGSMITH_TRACING=


# Career Research Configuration (Defaults)
DEFAULT_TARGET_ROLE=AI工程师
DEFAULT_TARGET_CITY=北京
DEFAULT_EDUCATION=本科
DEFAULT_EXPERIENCE_YEARS=3年
DEFAULT_SKILLS=Python, PyTorch, TensorFlow, 机器学习
# 简历背景资料：将简历放到 ./data/简历.md，Agent 会自动读取并注入到研究员提示；
# 也可在 LangGraph Studio 的 CareerConfig 中直接粘贴 user_profile 文本覆盖。


# Only necessary for Open Agent Platform
SUPABASE_KEY=
SUPABASE_URL=
# Should be set to true for a production deployment on Open Agent Platform. Should be set to false otherwise, such as for local development.
GET_API_KEYS_FROM_CONFIG=false


# RAG (Retrieval-Augmented Generation) Knowledge Base (可选)
# 设为 true 后，研究员会自动获得 retrieve_knowledge_base 工具（需先构建索引）。
RAG_ENABLED=false
# Embedding 模型：openai:text-embedding-3-small 或本地 sentence-transformers 模型名
RAG_EMBEDDING_MODEL=openai:text-embedding-3-small
# 向量库类型，当前仅实现 chroma
RAG_VECTOR_STORE=chroma
# 索引持久化目录
RAG_INDEX_PATH=./data/rag_index
# 集合名称
RAG_COLLECTION=career_kb
# 每次检索返回的片段数
RAG_TOP_K=4
# 使用 supabase (pgvector) 向量库时需要：Supabase 项目的 Postgres 连接串（postgresql://user:pass@host:5432/postgres）
SUPABASE_CONNECTION_STRING=


# ===== HTTP API / FastAPI 配置（可选） =====
# 运行环境：dev / staging / prod
#   prod 会开启启动前配置校验（fail fast）：CORS=*、未设 Bearer Token、
#   使用 memory checkpointer/store、关闭 JSON 日志等都会被拒绝启动。
API_ENV=dev
# Bearer Token 鉴权：设置后所有 /api/* 接口需携带 Authorization: Bearer <token>
API_BEARER_TOKEN=
# 逗号分隔的允许跨域来源（prod 不允许 *）
API_CORS_ORIGINS=*
# 是否允许跨域携带凭据。注意：浏览器规范禁止「* + 携带凭据」同时成立，
# 二者同时为真时服务会自动关闭凭据并打告警日志。
API_CORS_ALLOW_CREDENTIALS=false
# 监听地址与端口
API_HOST=0.0.0.0
API_PORT=8000
# 热重载（仅开发环境使用）
API_RELOAD=false
# 单次研究请求最大消息条数（超出返回 413）
API_MAX_MESSAGES=50
# 研究接口整体超时（秒），0 表示不限制；超时返回 504
API_RESEARCH_TIMEOUT=0
# 研究图状态后端：memory / none / postgres / redis
API_CHECKPOINTER=memory
# postgres 模式连接串（如 postgresql://user:pass@host:5432/db）
API_CHECKPOINTER_POSTGRES_DSN=
# redis 模式连接串（如 redis://localhost:6379），需先安装 langgraph-checkpoint-redis
API_CHECKPOINTER_REDIS_URI=
# Gap 分析缓存开关（on/off）与最大条目数
API_GAP_CACHE=on
API_GAP_CACHE_MAX=256
# 单客户端 IP 每分钟最大请求数，0 表示不限流（429 响应带 Retry-After）
API_RATE_LIMIT_PER_MINUTE=0
# 日志：是否输出单行 JSON、日志级别
API_LOG_JSON=true
API_LOG_LEVEL=INFO

# ===== 简历 / 画像档案文件（可选） =====
# 档案目录（GET /api/profile/names、POST /api/profile、/activate、/upload）
API_PROFILE_DIR=./data/profiles
# 当前生效的简历文件，需与 CareerConfig.resume_path 保持一致，否则"切换档案"不会影响 Agent
API_RESUME_PATH=./data/简历.md
# 简历上传大小上限（MB），对应 POST /api/profile/upload
API_UPLOAD_MAX_MB=5

# ===== 长期记忆 Store（可选） =====
# memory（默认，仅进程内） / none / postgres
# 注意：该项保持不带 API_ 前缀，以兼容既有部署脚本
MEMORY_STORE=memory
MEMORY_STORE_POSTGRES_DSN=

# ===== 连接串兜底（可选） =====
# 未设置 API_CHECKPOINTER_POSTGRES_DSN / MEMORY_STORE_POSTGRES_DSN 时回退到这里
POSTGRES_DSN=
# 未设置 API_CHECKPOINTER_REDIS_URI 时回退到这里
REDIS_URI=